{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "koadan-ai",
  "main": "src/index.js",
  "compatibility_date": "2026-10-02",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "ai": {
    "binding": "AI"
  }
}
